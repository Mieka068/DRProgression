# Datasets are volume-mounted at runtime (see DOCKER.md), never baked into the image.
*.zip

# Training outputs -- generated by the scripts themselves, shouldn't bloat the build context
# or get baked into the image if a local run happened before building.
training_samples_poc/
trajectory_figures/
DRForestGAN-v2/stargan/models_poc/
DRForestGAN-v2/stargan/models_poc_tianjin/
module3/module3_runs_poc/
*.ckpt
*.pth.tar

# Module 1 caches -- large, regenerable, and dataset-specific; mount these in instead.
module1_outputs_*.pt
registered_followups.pt
registration_net.ckpt

__pycache__/
*.pyc
.ipynb_checkpoints/
.git/
